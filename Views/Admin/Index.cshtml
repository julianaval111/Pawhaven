@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container-fluid">
    <h2 class="mb-2">Admin Dashboard</h2>
    <p class="text-muted">Welcome to the Pawhaven management system.</p>

    <div class="row g-3 mt-3">

        <div class="col-md-4 col-lg-3">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h6 class="text-muted">Total Users</h6>
                    <h2>@ViewBag.TotalUsers</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-lg-3">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h6 class="text-muted">Total Pets</h6>
                    <h2>@ViewBag.TotalPets</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-lg-3">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h6 class="text-muted">Grooming Services</h6>
                    <h2>@ViewBag.TotalServices</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-lg-3">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h6 class="text-muted">Total Bookings</h6>
                    <h2>@ViewBag.TotalBookings</h2>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-lg-3">
            <div class="card shadow-sm border-0">
                <div class="card-body">
                    <h6 class="text-muted">Pending Bookings</h6>
                    <h2>@ViewBag.PendingBookings</h2>
                </div>
            </div>
        </div>

    </div>

    <h4 class="mt-5 mb-3">Recent Bookings</h4>

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Customer</th>
                    <th>Pet</th>
                    <th>Service</th>
                    <th>Appointment</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var booking in ViewBag.RecentBookings)
                {
                    <tr>
                        <td>@booking.Owner?.FullName</td>
                        <td>@booking.Pet?.PetName</td>
                        <td>@booking.GroomingService?.ServiceName</td>
                        <td>@booking.AppointmentDate.ToString("MMM dd, yyyy")</td>
                        <td>@booking.Status</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>