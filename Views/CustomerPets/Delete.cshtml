@model Pawhaven.Models.Pet

@{
    ViewData["Title"] = "Delete Pet";
}

<h2>Delete Pet</h2>

<div class="card">
    <div class="card-body">
        <h5>Are you sure you want to delete this pet?</h5>

        <p><strong>Pet Name:</strong> @Model.PetName</p>
        <p><strong>Pet Type:</strong> @Model.PetType</p>
        <p><strong>Breed:</strong> @Model.Breed</p>
        <p><strong>Age:</strong> @Model.Age</p>

        <form asp-action="Delete" method="post">
            <input type="hidden" name="id" value="@Model.PetId" />

            <button type="submit" class="btn btn-danger">Delete</button>
            <a asp-action="Index" class="btn btn-secondary">Cancel</a>
        </form>
    </div>
</div>