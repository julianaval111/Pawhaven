
@{
    ViewData["Title"] = "Staff Dashboard";
}

<div class="container mt-4">

    <h2>Staff Dashboard</h2>
    <p>Welcome to the Pawhaven Reception Dashboard.</p>

    <div class="row mt-4">

        <div class="col-md-3 mb-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6>Total Bookings</h6>
                    <h2>@ViewBag.TotalBookings</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6>Pending Bookings</h6>
                    <h2>@ViewBag.PendingBookings</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6>Registered Pets</h6>
                    <h2>@ViewBag.TotalPets</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3 mb-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h6>Customers</h6>
                    <h2>@ViewBag.TotalCustomers</h2>
                </div>
            </div>
        </div>

    </div>

    <div class="mt-4">
        <h4>Staff Management</h4>

        <a asp-action="Bookings" class="btn btn-primary me-2">
            View Bookings
        </a>

        <a asp-action="Pets" class="btn btn-success">
            View Registered Pets
        </a>
    </div>

</div>
