@model IEnumerable<Pawhaven.Models.GroomingService>

@{
    ViewData["Title"] = "Grooming Services";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2>Grooming Services</h2>
        <p class="text-muted">Manage Pawhaven's grooming services and prices.</p>
    </div>

    <a asp-action="Create" class="btn btn-success">
        + Add Service
    </a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible fade show">
        @TempData["Success"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<form asp-action="Index" method="get" class="mb-3">
    <div class="input-group">
        <input type="text"
       id="searchBox"
       name="searchString"
       data-search-input
       data-search-target="searchResults"
       value="@ViewData["CurrentFilter"]"
       class="form-control"
       placeholder="Search service name or description..." />

        <button type="submit" class="btn btn-success">Search</button>

        <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
    </div>
</form>

<div class="card border-0 shadow-sm">
    <div class="card-body table-responsive">

        <table class="table table-hover align-middle">
            <thead class="table-light">
                <tr>
                    <th>Service Name</th>
                    <th>Description</th>
                    <th>Price</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody id="searchResults">
                @foreach (var service in Model)
                {
                    <tr>
                        <td>@service.ServiceName</td>
                        <td>@service.Description</td>
                        <td>₱@service.Price.ToString("N2")</td>

                        <td>
                            @if (service.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>

                        <td>
                            <a asp-action="Edit"
                               asp-route-id="@service.ServiceId"
                               class="btn btn-sm btn-outline-primary">
                                Edit
                            </a>

                            @if (service.IsActive)
                            {
                                <form asp-action="Delete"
                                      asp-route-id="@service.ServiceId"
                                      method="post"
                                      class="d-inline"
                                      onsubmit="return confirm('Deactivate this service?');">

                                    <button type="submit"
                                            class="btn btn-sm btn-outline-danger">
                                        Deactivate
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }

                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted">
                            No grooming services found.
                        </td>
                    </tr>
                }
            </tbody>
        </table>

    </div>
</div>